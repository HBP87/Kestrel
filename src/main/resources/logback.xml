<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Per-command DEBUG logging dominates request latency; enable it explicitly when needed. -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
